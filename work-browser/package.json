{
  "name": "lokal-browser",
  "productName": "Lokal",
  "version": "0.2.1",
  "description": "Локаль — рабочий браузер: закреплённые сервисы, вторая панель и свои расширения из папки.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "electron test/run.js --no-sandbox --no-proxy-server",
    "dist": "electron-builder --win zip --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.lokal.browser",
    "productName": "Lokal",
    "files": [
      "src/**/*",
      "ui/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../owa-restyle",
        "to": "extensions/owa-restyle",
        "filter": [
          "**/*",
          "!test/**",
          "!node_modules/**",
          "!package.json",
          "!.gitignore",
          "!screenshot*.png",
          "!apps-script/**"
        ]
      },
      {
        "from": "../band-restyle",
        "to": "extensions/band-restyle",
        "filter": [
          "**/*",
          "!test/**",
          "!node_modules/**",
          "!package.json",
          "!.gitignore",
          "!screenshot*.png",
          "!apps-script/**"
        ]
      },
      {
        "from": "../smeta-extension",
        "to": "extensions/smeta-extension",
        "filter": [
          "**/*",
          "!test/**",
          "!node_modules/**",
          "!package.json",
          "!.gitignore",
          "!screenshot*.png",
          "!apps-script/**"
        ]
      },
      {
        "from": "../weblate-extension",
        "to": "extensions/weblate-extension",
        "filter": [
          "**/*",
          "!test/**",
          "!node_modules/**",
          "!package.json",
          "!.gitignore",
          "!screenshot*.png",
          "!apps-script/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "artifactName": "Lokal-${version}-win.${ext}"
  }
}
